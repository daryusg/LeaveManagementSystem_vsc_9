@model IEnumerable<EmployeeVM>

@{
}

@Html.ValidationSummary(true, "", new { @class = "text-danger" }) @*04/05/25*@

@*@foreach (var item in Model)*@
@foreach (var roleGroup in Model.GroupBy(e => e.RoleName)) //11/07/25
{
    <h1>@roleGroup.Key</h1>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Email)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FirstName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LastName)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach(var item in roleGroup)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
                <td>
                    <a asp-action="Details" class="btn btn-primary" asp-route-employeeId="@item.Id">View Allocations</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}